# Copy this file to .env and fill in your own values. .env is gitignored.

# Contact address sent in every scraper's User-Agent (required)
SCRAPER_CONTACT=you@example.edu

# Seconds to wait between requests to the same host
REQUEST_DELAY_SECONDS=3

# Snapshot date for all collection (YYYY-MM-DD)
SNAPSHOT_DATE=

# Optional: cap every chart at this many titles for a test run (leave blank on the snapshot date)
CHART_LIMIT=
